# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Output of the go coverage tool
*.coverprofile

# Go workspace file
go.work
go.work.sum

# Dependency directories (vendor/)
vendor/

# Go build cache
*.a

# IDE/editor config
.vscode/
.idea/
*.sw?
*.sublime-*
*.code-workspace

# OS generated files
.DS_Store
Thumbs.db
ehthumbs.db
Icon?
Desktop.ini

# Logs
*.log

# Environment files
.env
.env.*

# Docker
docker-compose.override.yml
docker-compose.local.yml

# PostgreSQL data
postgres_data/
**/postgres_data/
**/migrations/

# SQLC generated code (if you want to ignore generated code)
# Uncomment if you want to ignore generated code
# internal/adapters/postgres/sqlc/

# Test output
*.testresult
*.tmp

# Coverage reports
coverage.*
*.lcov

# Node modules (if any frontend)
node_modules/

# Backup files
*~
*.bak
*.swp
*.swo

# Ignore compiled API docs
docs/

# Ignore binaries in cmd/
cmd/*/*.out
cmd/*/*.exe

# Ignore local README overrides
README.local.md

# Ignore custom config
config.local.*